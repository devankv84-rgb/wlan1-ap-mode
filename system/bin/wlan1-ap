#!/system/bin/sh

CONFIG_DIR="/data/local/tmp/wlan1_ap"
HOSTAPD_CONF="$CONFIG_DIR/hostapd.conf"
DNSMASQ_CONF="$CONFIG_DIR/dnsmasq.conf"

# Native Android binary paths
HOSTAPD_BIN="/vendor/bin/hw/hostapd"
DNSMASQ_BIN="/system/bin/dnsmasq"

init_configs() {
    mkdir -p "$CONFIG_DIR"

    if [ ! -f "$HOSTAPD_CONF" ]; then
        cat << 'CONF' > "$HOSTAPD_CONF"
interface=wlan1
driver=nl80211
ssid=NetHunter_AP
hw_mode=g
channel=6
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_passphrase=your_secure_password
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
CONF
    fi

    if [ ! -f "$DNSMASQ_CONF" ]; then
        cat << 'CONF' > "$DNSMASQ_CONF"
interface=wlan1
dhcp-range=192.168.42.10,192.168.42.50,12h
dhcp-option=3,192.168.42.1
dhcp-option=6,8.8.8.8
bind-interfaces
pid-file=/data/local/tmp/wlan1_ap/dnsmasq.pid
CONF
    fi
}

start_ap() {
    echo "[+] Initializing wlan1 Access Point..."
    init_configs

    # Bring down interface and set AP mode
    ip link set wlan1 down 2>/dev/null
    iw dev wlan1 set type ap
    ip link set wlan1 up
    ip addr add 192.168.42.1/24 dev wlan1 2>/dev/null

    # Enable IPv4 forwarding
    echo 1 > /proc/sys/net/ipv4/ip_forward

    # Detect upstream internet interface
    UPSTREAM="wlan0"
    if ip route | grep -q "dev rmnet"; then
        UPSTREAM=$(ip route | grep default | awk '{print $5}' | head -n1)
    fi
    echo "[+] Upstream internet interface: $UPSTREAM"

    # Set up NAT / IPTables rules
    iptables -F
    iptables -t nat -F
    iptables -t nat -A POSTROUTING -o "$UPSTREAM" -j MASQUERADE
    iptables -A FORWARD -i "$UPSTREAM" -o wlan1 -m state --state RELATED,ESTABLISHED -j ACCEPT
    iptables -A FORWARD -i wlan1 -o "$UPSTREAM" -j ACCEPT

    # Start DNSMASQ
    pkill dnsmasq 2>/dev/null
    "$DNSMASQ_BIN" -C "$DNSMASQ_CONF" &
    echo "[+] DHCP server started."

    # Export dynamic linker library paths including APEX VNDK for hostapd dependencies
    export LD_LIBRARY_PATH=/apex/com.android.vndk.v33/lib64:/vendor/lib64:/system/lib64:$LD_LIBRARY_PATH

    # Launch HOSTAPD
    echo "[+] Launching hostapd..."
    "$HOSTAPD_BIN" "$HOSTAPD_CONF"
}

stop_ap() {
    echo "[-] Stopping wlan1 AP..."
    pkill hostapd 2>/dev/null
    pkill dnsmasq 2>/dev/null
    ip link set wlan1 down 2>/dev/null
    iptables -t nat -F
    iptables -F
    echo "[-] Done."
}

case "$1" in
    start)
        start_ap
        ;;
    stop)
        stop_ap
        ;;
    *)
        echo "Usage: wlan1-ap {start|stop}"
        exit 1
        ;;
esac
